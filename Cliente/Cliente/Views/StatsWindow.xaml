<Window x:Class="Cliente.Views.StatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Estatistikak"
        Width="1000" Height="720"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Color x:Key="AccentColor">#E0625E</Color>
        <Color x:Key="AccentDark">#C44F4B</Color>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8A8A8A"/>
        <DropShadowEffect x:Key="CardShadow" Color="#44000000" BlurRadius="18" ShadowDepth="4"/>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F7F9FB" Offset="0"/>
                <GradientStop Color="#EEF2F5" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Ellipse Width="580" Height="580" Fill="#20E0625E"
                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-180,-180,0"/>

        <Border Width="920" Padding="22" CornerRadius="16" Background="White"
                HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource CardShadow}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Source}" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="{Binding ReportDate}" Grid.Column="1" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                </Grid>

                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <TextBlock Text="{Binding FiltersSummary}" Foreground="{StaticResource MutedBrush}"/>
                </Border>

                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,10">
                        <Border Style="{StaticResource Card}" Margin="4">
                            <StackPanel>
                                <TextBlock Text="Jokatutakoak" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="{Binding TotalMatches}" FontSize="18" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="4">
                            <StackPanel>
                                <TextBlock Text="Garaipen %" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="{Binding WinRate, StringFormat={}{0:F1}%}" FontSize="18" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="4">
                            <StackPanel>
                                <TextBlock Text="Surrender" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="{Binding Surrenders}" FontSize="18" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="4">
                            <StackPanel>
                                <TextBlock Text="Avg Alive (Win)" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="{Binding AvgAliveOnWin, StringFormat={}{0:F1}}" FontSize="18" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Garaipenak aurkariaren arabera" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding ChartItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,4,0,4">
                                            <TextBlock Text="{Binding Opponent}" FontWeight="SemiBold"/>
                                            <Grid>
                                                <ProgressBar Height="10" Maximum="100"
                                                             Value="{Binding WinRate, Mode=OneWay}"
                                                             Foreground="{StaticResource AccentBrush}" Background="#EEE"/>
                                                <TextBlock Text="{Binding Wins, StringFormat={}Wins: {0}}"
                                                           VerticalAlignment="Center" Margin="4,-2,0,0"
                                                           FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Losses, StringFormat={}Losses: {0}}"
                                                       FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Azken 5 partidak" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <DataGrid ItemsSource="{Binding RecentMatches}" AutoGenerateColumns="False"
                                      HeadersVisibility="Column" CanUserAddRows="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Data" Binding="{Binding Date, Mode=OneWay}" Width="*"/>
                                    <DataGridTextColumn Header="Aurkaria" Binding="{Binding Opponent, Mode=OneWay}" Width="*"/>
                                    <DataGridTextColumn Header="Emaitza" Binding="{Binding Result, Mode=OneWay}" Width="*"/>
                                    <DataGridTextColumn Header="Arrazoia" Binding="{Binding EndReason, Mode=OneWay}" Width="*"/>
                                    <DataGridTextColumn Header="Bizirik" Binding="{Binding AliveSummary, Mode=OneWay}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="Descargar PDF" Width="150" Margin="0,0,8,0" Style="{StaticResource PrimaryButton}" Click="BtnExportPdf_Click"/>
                    <Button Content="Itxi" Width="110" Style="{StaticResource PrimaryButton}" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
