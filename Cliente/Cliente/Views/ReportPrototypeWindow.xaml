<Window x:Class="Cliente.Views.ReportPrototypeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Txosten prototipoa"
        Width="1000" Height="720"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Color x:Key="AccentColor">#E0625E</Color>
        <Color x:Key="AccentDark">#C44F4B</Color>

        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8A8A8A"/>

        <DropShadowEffect x:Key="CardShadow"
                          Color="#44000000"
                          BlurRadius="18"
                          ShadowDepth="4"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F7F9FB" Offset="0"/>
                <GradientStop Color="#EEF2F5" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Ellipse Width="580"
                 Height="580"
                 Fill="#20E0625E"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top"
                 Margin="0,-180,-180,0"/>

        <Border Width="920"
                Padding="22"
                CornerRadius="16"
                Background="White"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Effect="{StaticResource CardShadow}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="{Binding Title}"
                               FontSize="20"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Subtitle}"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Meta -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding Source}"
                               Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="{Binding ReportDate}"
                               Grid.Column="1"
                               HorizontalAlignment="Right"
                               Foreground="{StaticResource MutedBrush}"/>
                </Grid>

                <!-- Filters -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <TextBlock Text="{Binding FiltersSummary}"
                               Foreground="{StaticResource MutedBrush}"/>
                </Border>

                <!-- Body -->
                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Summary cards -->
                    <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,10">
                        <Border Style="{StaticResource Card}" Margin="4">
                            <StackPanel>
                                <TextBlock Text="Jokatutakoak" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="{Binding TotalMatches}" FontSize="18" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="4">
                            <StackPanel>
                                <TextBlock Text="Garaipen %" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="{Binding WinRate, StringFormat={}{0:F1}%}" FontSize="18" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="4">
                            <StackPanel>
                                <TextBlock Text="Surrender" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="{Binding Surrenders}" FontSize="18" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="4">
                            <StackPanel>
                                <TextBlock Text="Avg Alive (Win)" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="{Binding AvgAliveOnWin, StringFormat={}{0:F1}}" FontSize="18" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Chart -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Garaipenak aurkariaren arabera"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>

                            <ItemsControl ItemsSource="{Binding ChartItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,4,0,4">
                                            <TextBlock Text="{Binding Opponent}" FontWeight="SemiBold"/>
                                            <Grid>
                                                <!-- ProgressBar -->
                                                <ProgressBar Height="10"
                                                             Maximum="100"
                                                             Value="{Binding WinRate, Mode=OneWay}"
                                                             Foreground="{StaticResource AccentBrush}"
                                                             Background="#EEE"/>

                                                <TextBlock Text="{Binding Wins, StringFormat={}Wins: {0}}"
                                                           VerticalAlignment="Center"
                                                           Margin="4,-2,0,0"
                                                           FontSize="10"
                                                           Foreground="{StaticResource MutedBrush}"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Losses, StringFormat={}Losses: {0}}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource MutedBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Details -->
                    <Border Grid.Row="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Azken 5 partidak"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>

                            <DataGrid ItemsSource="{Binding RecentMatches}"
                                      AutoGenerateColumns="False"
                                      HeadersVisibility="Column"
                                      CanUserAddRows="False"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Data" Binding="{Binding Date}" Width="*"/>
                                    <DataGridTextColumn Header="Aurkaria" Binding="{Binding Opponent}" Width="*"/>
                                    <DataGridTextColumn Header="Emaitza" Binding="{Binding Result}" Width="*"/>
                                    <DataGridTextColumn Header="Arrazoia" Binding="{Binding EndReason}" Width="*"/>
                                    <DataGridTextColumn Header="Bizirik" Binding="{Binding AliveSummary}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>